{
  "name": "svg-stacker",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Turn an SVG into a stacked, color-change-ready 3MF for OrcaSlicer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "clipper2-ts": "^2.0.1-18",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgpath": "^2.6.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
